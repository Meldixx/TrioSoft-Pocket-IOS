{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrioSoft Pocket",
  "version": "0.1.1",
  "identifier": "xyz.triosoft.pocket",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TrioSoft Pocket",
        "width": 420,
        "height": 860,
        "minWidth": 360,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
